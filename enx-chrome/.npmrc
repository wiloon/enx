# Local dev: resolve packages through the Nexus npm group -> npm-proxy ->
# https://registry.npmmirror.com, with a local cache in Nexus.
# Setup: infra/homelab/k8s/nexus/scripts/setup-npm-proxy.sh (w10n-config repo).
# Anonymous read is enabled, so no auth token here.
# NOTE: nexus.wiloon.com only resolves on the homelab LAN / wg tunnel; off-network
# clones must override `registry` (e.g. `pnpm install --registry=https://registry.npmmirror.com`).
registry=https://nexus.wiloon.com/repository/npm-group/
network-timeout=1200000
fetch-retries=10
fetch-retry-mintimeout=60000
fetch-retry-maxtimeout=600000
network-concurrency=8
