# ENX Chrome Extension Environment Configuration

# Sentry DSN for error tracking
VITE_SENTRY_DSN=your_sentry_dsn_here

# Override the environment (development, staging, production)
# If not set, auto-detects based on build mode (dev/prod)
# VITE_ENV=development

# Available configurations:
# - development: http://localhost:8090 (local API server)
# - staging: https://enx-api.wiloon.lab (homelab lab deployment)
# - production: https://enx-api.wiloon.com (API; UI at https://enx.wiloon.com)
