# ENX Chrome Extension Environment Configuration

# Sentry DSN for error tracking
VITE_SENTRY_DSN=your_sentry_dsn_here

# Override the environment (development, homelab, production)
# If not set, the Vite mode decides: `vite build --mode homelab|production`
# VITE_ENV=development

# Available configurations (see src/config/targets.ts):
# - development: http://localhost:8091 (local API server)
# - homelab:     https://enx-api.wiloon.lab (homelab k8s deployment)
# - production:  https://api.catglish.com (API; UI at https://catglish.com)

# Per-build overrides of single values (optional). Only the selected target,
# with these applied, is built into the extension; nothing switches at run time.
# VITE_API_BASE_URL=http://192.168.50.71:8090
# VITE_FRONTEND_BASE_URL=http://192.168.50.71:3000
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
# VITE_CLERK_SYNC_HOST=https://clerk.catglish.com
# enx-ui origins: Reader, external messaging and the data-enx-* page stamps
# VITE_ENX_UI_ORIGINS=https://catglish.com
# Generic sites that also get the content script (e.g. the E2E fixture server)
# VITE_CONTENT_SCRIPT_ORIGINS=http://localhost:8765

# Learning mode skips an article whose body has more Chinese characters than
# this (default 20; 0 = skip on the first one). Room for an English article
# that glosses a name or term in Chinese.
# VITE_HAN_CHAR_LIMIT=20
