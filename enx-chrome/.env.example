# ENX Chrome Extension Environment Configuration

# Sentry DSN for error tracking
VITE_SENTRY_DSN=your_sentry_dsn_here

# Override the environment (development, homelab, production)
# If not set, the Vite mode decides: `vite build --mode homelab|production`
# VITE_ENV=development

# Available configurations (see src/config/targets.ts):
# - development: http://localhost:8090 (local API server)
# - homelab:     https://enx-api.wiloon.lab (homelab k8s deployment)
# - production:  https://enx-api.wiloon.com (API; UI at https://enx.wiloon.com)

# Per-build overrides of single values (optional)
# VITE_API_BASE_URL=http://192.168.50.71:8090
# VITE_FRONTEND_BASE_URL=http://192.168.50.71:3000
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
# VITE_CLERK_SYNC_HOST=https://enx.wiloon.com
# VITE_ENX_UI_ORIGINS=https://enx.wiloon.com,http://localhost:3000
