{
  "name": "enx-chrome-extension",
  "version": "1.0.1",
  "description": "Chrome extension for English learning with React, TypeScript, and Jotai",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && vite build --mode homelab",
    "build:homelab": "pnpm build",
    "build:dev": "tsc -p tsconfig.app.json && vite build --mode development",
    "build:prod": "tsc -p tsconfig.app.json && vite build --mode production",
    "package:webstore": "pnpm build:prod && node scripts/package-webstore.mjs",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:homelab": "playwright test --config playwright.homelab.config.ts",
    "smoke:homelab": "node scripts/homelab-smoke.mjs",
    "test:all": "pnpm test && pnpm test:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@clerk/chrome-extension": "^3.1.85",
    "@floating-ui/dom": "^1.8.0",
    "@heroicons/react": "^2.2.0",
    "@sentry/react": "^10.75.3",
    "jotai": "^2.20.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chrome": "^0.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "http-server": "^14.1.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.13",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "packageManager": "pnpm@12.6.0"
}
