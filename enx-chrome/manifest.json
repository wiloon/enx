{
  "manifest_version": 3,
  "key": "",
  "name": "Catglish - Learn English as you read the web",
  "description": "Explains any word you click as you read English online, underlines the words you've looked up, and translates whole sentences.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "notifications",
    "contextMenus",
    "sidePanel",
    "cookies"
  ],
  "host_permissions": [],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Catglish"
  },
  "background": {
    "service_worker": "src/background/background.ts"
  },
  "content_scripts": [
    {
      "matches": [
        "https://rssx-lab.wiloon.com/*",
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["src/content/content.tsx"],
      "run_at": "document_end"
    }
  ],
  "externally_connectable": {
    "matches": []
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Open Catglish"
    }
  }
}
