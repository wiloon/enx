{
  "manifest_version": 3,
  "key": "",
  "name": "ENX - English Learning Extension",
  "version": "1.0.1",
  "description": "AI-powered English learning assistant that helps you learn vocabulary while browsing the web",
  "permissions": ["storage", "activeTab", "scripting", "notifications", "identity", "sidePanel", "contextMenus", "cookies"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://localhost:8090/*",
    "https://enx-api.wiloon.lab/*",
    "https://enx.wiloon.lab/*",
    "https://enx-api.wiloon.com/*",
    "https://enx.wiloon.com/*",
    "https://rational-deer-4450.clerk.accounts.dev/*",
    "https://www.youdao.com/*",
    "https://claude.com/blog/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ENX English Learning"
  },
  "background": {
    "service_worker": "src/background/background.ts"
  },
  "content_scripts": [
    {
      "matches": [
        "https://rssx-lab.wiloon.com/*",
        "https://www.infoq.com/*",
        "https://messaging-custom-newsletters.nytimes.com/*",
        "https://developers.googleblog.com/*",
        "https://www.microsoft.com/en-us/research/*",
        "https://www.reuters.com/*",
        "https://www.anthropic.com/*",
        "https://anthropic.skilljar.com/*",
        "https://claude.com/blog/*",
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["src/content/content.tsx"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Toggle ENX learning mode"
    }
  }
}
