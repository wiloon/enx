{
  "manifest_version": 3,
  "key": "",
  "name": "Catglish - Learn English as you read the web",
  "version": "1.0.1",
  "description": "Underlines the words worth learning as you read English online, explains any word you click, and translates whole sentences.",
  "permissions": ["storage", "activeTab", "scripting", "notifications", "identity", "sidePanel", "contextMenus", "cookies"],
  "host_permissions": [],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Catglish"
  },
  "background": {
    "service_worker": "src/background/background.ts"
  },
  "content_scripts": [
    {
      "matches": [
        "https://rssx-lab.wiloon.com/*",
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["src/content/content.tsx"],
      "run_at": "document_end"
    }
  ],
  "externally_connectable": {
    "matches": []
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Toggle Catglish learning mode"
    }
  }
}
