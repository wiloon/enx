# ENX API Environment Configuration
# Copy this file to .env and modify as needed
# This file is for local development - DO NOT commit to git

# API Server Port (overrides config.toml)
ENX_PORT=8091

# Log level: debug | info | warn | error. Defaults to info; the repo's
# config.toml sets debug for local development.
# LOG_LEVEL=info

# Database Path
DB_PATH=/var/lib/enx-api/enx.db

# ECDICT Database Path
# Path to the ECDICT SQLite database file. Leave unset for local development:
# `task dev` / `task api:run` default it to ~/.local/share/enx/ecdict/stardict.db,
# which `task ecdict:download` (repo root) fills. An empty value here does not
# override that default.
# ECDICT_DB_PATH=

# Data Service Address
# (currently not supported by env var, use config.toml)
# DATA_SERVICE_ADDRESS=localhost:50051

# Resend Email API (for user registration email verification)
# Register at: https://resend.com/
RESEND_API_KEY=your_resend_api_key_here
