FROM node:22-alpine AS builder
WORKDIR /app
COPY .npmrc ./
RUN npm install -g pnpm@9.15.9
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN for i in 1 2 3 4 5; do \
      pnpm fetch --frozen-lockfile || true; \
      pnpm install --frozen-lockfile --prefer-offline && break; \
      echo "pnpm install attempt $i failed, retrying in 60s..."; sleep 60; \
    done
COPY . .
# Defaults target the homelab lab deployment. The Tekton pipeline
# (infra/homelab/k8s/tekton/pipeline-build-enx-ui.yaml) overrides these via
# --build-arg; a bare `docker build` should still land somewhere real.
ARG NEXT_PUBLIC_API_BASE_URL=https://enx-api.wiloon.lab
# Clerk (ADR-015). Publishable key + these URLs are inlined into the bundle at
# build time (NEXT_PUBLIC_*), so the Tekton pipeline passes them via --build-arg.
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_cmF0aW9uYWwtZGVlci00NDUwLmNsZXJrLmFjY291bnRzLmRldiQ
ARG NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
ARG NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
ARG NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
ARG NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=$NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_CLERK_SIGN_IN_URL=$NEXT_PUBLIC_CLERK_SIGN_IN_URL
ENV NEXT_PUBLIC_CLERK_SIGN_UP_URL=$NEXT_PUBLIC_CLERK_SIGN_UP_URL
ENV NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=$NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL
ENV NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=$NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL
# clerkMiddleware() needs SOME secret key present during `next build`; the real
# value is injected at runtime from the k8s Secret `enx-clerk`. This dummy never
# leaves the build stage.
ENV CLERK_SECRET_KEY=sk_test_build_time_placeholder_only
RUN pnpm build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public
EXPOSE 3000
CMD ["node", "server.js"]
