FROM node:22-alpine AS builder
WORKDIR /app
COPY .npmrc ./
# Homelab CI: the Tekton pipeline (pipeline-build-enx-ui.yaml) passes the
# in-cluster Nexus npm-group URL here so the build resolves packages over plain
# HTTP -- node:22-alpine ships only the public CA bundle and does not trust the
# internal *.wiloon.com cert Kong serves on https://nexus.wiloon.com. A bare
# `docker build` leaves this empty and keeps the committed .npmrc registry.
ARG NPM_REGISTRY=
RUN if [ -n "$NPM_REGISTRY" ]; then sed -i "s|^registry=.*|registry=$NPM_REGISTRY|" .npmrc; fi
RUN npm install -g pnpm@9.15.9
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# Retry the install (the npm proxy is flaky), but fail the layer if every
# attempt fails: a bare `for` exits with the status of its last command (the
# `sleep`), which used to let a broken node_modules through to `pnpm build`.
# The trailing `rm` drops the pnpm store once node_modules is populated:
# node_modules is hard-linked from it, so the store adds ~42k extra entries
# (and ~10MB) to this layer, all re-created each time the cached layer is
# extracted. Nothing after this needs it (`pnpm build` does not touch the store).
RUN ok=0; \
    for i in 1 2 3 4 5; do \
      pnpm fetch --frozen-lockfile || true; \
      if pnpm install --frozen-lockfile --prefer-offline; then ok=1; break; fi; \
      echo "pnpm install attempt $i failed, retrying in 60s..."; sleep 60; \
    done; \
    [ "$ok" = 1 ] || { echo "pnpm install failed after 5 attempts" >&2; exit 1; }; \
    rm -rf "$(pnpm store path)"
COPY . .
# No deployment-specific build-args: every per-environment value
# (CLERK_PUBLISHABLE_KEY, API_BASE_URL, SITE_URL, ENX_EXTENSION_ID, ...) is read
# at RUNTIME -- see next.config.ts rewrites, src/lib/runtimeEnv.ts and the
# root layout. One image therefore runs in homelab and in production.
#
# These four are the same in every deployment (routing, not configuration), so
# inlining them is harmless.
ENV NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
ENV NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
ENV NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
ENV NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app
# clerkMiddleware() needs SOME secret key present during `next build`; the real
# value arrives at runtime from the env file / k8s Secret. This dummy never
# leaves the build stage.
ENV CLERK_SECRET_KEY=sk_test_build_time_placeholder_only
# No point phoning home from a CI build (it also stalls ~3s on the first call).
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public
EXPOSE 3000
CMD ["node", "server.js"]
